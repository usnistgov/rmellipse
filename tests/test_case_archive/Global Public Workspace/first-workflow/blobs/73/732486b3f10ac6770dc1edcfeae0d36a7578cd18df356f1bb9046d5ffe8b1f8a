requires-releases:
  # specify with version qualifiers, using a indexes from
  # a settings file
  - 'first-workflow>=0.1.0'
  # set the source as part of the requirements
  # using the uv.lock file in the root of the project as an example
  # mark files from somewhere arbitrary
  # - {'dataset': 'historical_data', 'from': 'filepath/to/dataset'}

requires-env:
  # For something
  - MY_ENV_VARIABLE
  - MY_OTHER_ENV_VARIABLE


release:
  # name of the release
  title: 'second-workflow'
  # version tag
  version: '0.1.0'
  includes:
    - '{my-output}'
  ignores:
    - 'inputs/*'

datasets:
  my-input: 'data_env/first-workflow/my-output.txt'
  my-output: 'results/output-file-2.txt'

# run some validation parameters
jobs:
  copy-file:
      for each:
        iterator: fi
        in: [file1, file2, file2]
      inputs:
        - '{connect}'
        - '{my-input}'
      outputs:
        - '{my-output}'
      commands:
        -['analyze', {connect}, {my-input}]


  matlab:
    commands:
      - ['matlab','-batch','"disp(1.0)"']